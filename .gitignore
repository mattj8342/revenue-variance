# Data is private by default. Only reviewed synthetic examples belong here.
/data/*
!/data/synthetic/
!/data/synthetic/README.md
!/data/synthetic/*.csv

# Identity mappings remain excluded, including under synthetic data.
mapping/
mappings/
*mapping*.csv
*crosswalk*.csv

# Private source material and runtime outputs
private/
raw/
exports/
/outputs/
/logs/
/reports/private/

# Python and notebooks
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

