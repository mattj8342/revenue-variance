# Credentials and local configuration
.env
.env.*
!.env.example
credentials/
secrets/
*.pem
*.key
*.pfx
*.p12

# Raw exports and local analytical files, wherever placed
*.csv
*.tsv
*.xlsx
*.xls
*.xlsb
*.parquet
*.feather
*.duckdb
*.db
